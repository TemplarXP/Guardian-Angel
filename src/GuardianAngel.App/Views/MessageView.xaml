<UserControl x:Class="GuardianAngel.App.Views.MessageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Margin="32" MaxWidth="640" HorizontalAlignment="Left">
    <TextBlock x:Name="TitleText" Style="{StaticResource H1}"/>
    <TextBlock x:Name="BodyText" Style="{StaticResource Muted}" Margin="0,0,0,16"/>
    <Button x:Name="ActionButton" Style="{StaticResource Primary}" HorizontalAlignment="Left" Click="ActionButton_Click"/>
  </StackPanel>
</UserControl>
