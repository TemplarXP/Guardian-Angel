<UserControl x:Class="GuardianAngel.App.Views.GuideView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel Margin="32">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,16,0,0">
      <Button x:Name="BackButton" Content="Back" Click="Back_Click"/>
      <Button x:Name="NextButton" Content="Next" Style="{StaticResource Primary}" Click="Next_Click"/>
      <Button x:Name="SkipButton" Content="Skip the guide" Click="Skip_Click"/>
      <TextBlock x:Name="PageText" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0"/>
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel MaxWidth="680" HorizontalAlignment="Left">
        <TextBlock x:Name="Intro" Style="{StaticResource Muted}" Text="A quick guide. You can read it again any time from the Learn tab." Margin="0,0,0,12"/>
        <TextBlock x:Name="TopicTitle" Style="{StaticResource H1}"/>
        <TextBlock x:Name="TopicBody" FontSize="15" LineHeight="22"/>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
