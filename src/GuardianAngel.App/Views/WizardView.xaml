<UserControl x:Class="GuardianAngel.App.Views.WizardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:GuardianAngel.App.Views">
  <DockPanel Margin="32,24">
    <TextBlock DockPanel.Dock="Top" x:Name="StepTitle" Style="{StaticResource H1}"/>
    <TextBlock DockPanel.Dock="Top" x:Name="StepCounter" Style="{StaticResource Muted}" Margin="0,0,0,12"/>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
      <Button x:Name="BackButton" Content="Back" Click="Back_Click"/>
      <Button x:Name="NextButton" Content="Next" Style="{StaticResource Primary}" Click="Next_Click"/>
      <TextBlock x:Name="ErrorText" Foreground="{StaticResource Bad}" VerticalAlignment="Center" Margin="8,0,0,0" MaxWidth="560"/>
    </StackPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <Grid MaxWidth="720" HorizontalAlignment="Left">

        <!-- 1. Choose setup -->
        <StackPanel x:Name="StepSetup">
          <RadioButton x:Name="PathSimple" GroupName="Path" IsChecked="True">
            <StackPanel>
              <TextBlock Text="Simple" FontWeight="SemiBold"/>
              <TextBlock Style="{StaticResource Muted}" Text="One public filter for everything. The easiest choice, and it works on any network."/>
            </StackPanel>
          </RadioButton>
          <RadioButton GroupName="Path" IsEnabled="False">
            <StackPanel>
              <TextBlock Text="Home + on the go (coming in a later version)" FontWeight="SemiBold"/>
              <TextBlock Style="{StaticResource Muted}" Text="Your home DNS server at home, and a public filter when you're away."/>
            </StackPanel>
          </RadioButton>
          <RadioButton GroupName="Path" IsEnabled="False">
            <StackPanel>
              <TextBlock Text="Own server everywhere with Tailscale (coming in a later version)" FontWeight="SemiBold"/>
              <TextBlock Style="{StaticResource Muted}" Text="Your own AdGuard Home or Pi-hole, reached through Tailscale wherever you are."/>
            </StackPanel>
          </RadioButton>
          <Border Style="{StaticResource Card}" Margin="0,16,0,0">
            <StackPanel>
              <TextBlock Text="How the Simple setup works" FontWeight="SemiBold"/>
              <TextBlock Style="{StaticResource Muted}" Text="1. Pick a filter from the list, or enter your own.&#x0a;2. Guardian Angel tests it.&#x0a;3. You choose how unlocking works.&#x0a;4. You press Lock. Guardian Angel sets your filter on every network adapter and blocks other DNS servers."/>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- 2. Filter -->
        <StackPanel x:Name="StepFilter" Visibility="Collapsed">
          <v:FilterEditor x:Name="Editor"/>
        </StackPanel>

        <!-- 3. Connection test -->
        <StackPanel x:Name="StepTest" Visibility="Collapsed">
          <TextBlock Text="Guardian Angel checks that your filter answers, using the same connection it will lock in."/>
          <TextBlock Text="Optional: a site your filter should block (to confirm the filter is really filtering)" Margin="0,12,0,0"/>
          <TextBox x:Name="BlockedDomainBox"/>
          <Button x:Name="RunTestButton" Content="Run the test" Style="{StaticResource Primary}" HorizontalAlignment="Left" Click="RunTest_Click"/>
          <Border Style="{StaticResource Card}" Margin="0,16,0,0">
            <StackPanel>
              <TextBlock x:Name="TestSummary" Text="Not tested yet." FontWeight="SemiBold"/>
              <ItemsControl x:Name="TestServers" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Style="{StaticResource Muted}">
                      <Run Text="{Binding Server, Mode=OneWay}"/>: <Run Text="{Binding Detail, Mode=OneWay}"/>
                    </TextBlock>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock x:Name="BlockAnswers" Style="{StaticResource Muted}"/>
              <CheckBox x:Name="ConfirmBlockPage" Visibility="Collapsed" Content="These addresses are my filter's block page"/>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- 4. Unlock method -->
        <StackPanel x:Name="StepUnlock" Visibility="Collapsed">
          <TextBlock Text="Loosening anything (changing the filter, a shorter delay, removing your partner, uninstalling) needs one of these. You can use both."/>
          <CheckBox x:Name="UseDelay" IsChecked="True" Margin="0,12,0,0" Content="Time delay: loosening waits this long"/>
          <v:DelayPicker x:Name="Delay" Margin="24,0,0,0"/>
          <TextBlock x:Name="DelayLimits" Style="{StaticResource Muted}" FontSize="12" Margin="24,0,0,8"/>

          <CheckBox x:Name="UsePartner" Content="Accountability partner: their code approves a change right away" Checked="UsePartner_Checked" Unchecked="UsePartner_Unchecked"/>
          <Border x:Name="PartnerCard" Style="{StaticResource Card}" Visibility="Collapsed" Margin="24,4,0,0">
            <StackPanel>
              <TextBlock Text="Ask your partner to scan this with an authenticator app (Google Authenticator, Microsoft Authenticator, Authy, 2FAS...)."/>
              <Image x:Name="QrImage" Width="220" Height="220" HorizontalAlignment="Left" Margin="0,8"/>
              <TextBlock x:Name="ManualSecret" Style="{StaticResource Muted}" FontSize="12"/>
              <TextBlock Text="Then type the 6-digit code their app shows:" Margin="0,8,0,0"/>
              <StackPanel Orientation="Horizontal">
                <TextBox x:Name="PartnerCodeBox" Width="120" MaxLength="6"/>
                <Button Content="Confirm" Margin="8,4,0,8" Click="ConfirmPartner_Click"/>
              </StackPanel>
              <TextBlock x:Name="PartnerStatus"/>
              <TextBlock Style="{StaticResource Muted}" FontSize="12" Text="After this, the QR code can never be shown again, not even to you. This keeps the partner's code in the partner's hands."/>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- 5. Reflection -->
        <StackPanel x:Name="StepReflection" Visibility="Collapsed">
          <TextBlock Text="Write a message to yourself. Guardian Angel shows it every time you ask to loosen something. Your reasons, a verse, a promise."/>
          <TextBox x:Name="ReflectionBox" AcceptsReturn="True" TextWrapping="Wrap" Height="160" MaxLength="2000" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0"/>
        </StackPanel>

        <!-- 6. Browsers -->
        <StackPanel x:Name="StepBrowsers" Visibility="Collapsed">
          <TextBlock Text="Browsers have their own &quot;secure DNS&quot; that would skip your filter. Guardian Angel always turns it off in Chrome, Edge, Brave and Firefox."/>
          <TextBlock Text="Optional extras" FontWeight="SemiBold" Margin="0,12,0,0"/>
          <CheckBox x:Name="DisablePrivate" Content="Turn off incognito / private windows"/>
          <CheckBox x:Name="BlockProxy" Content="Block proxy and VPN extensions (browsers will always connect directly)"/>
          <Border Style="{StaticResource Card}" Margin="0,16,0,0">
            <TextBlock Style="{StaticResource Muted}" Text="A full security scan of your PC (VPN apps, admin rights, app control and more) arrives in a later version. Milestone 1 locks DNS, the firewall, browsers and the hosts file."/>
          </Border>
        </StackPanel>

        <!-- 7. Summary -->
        <StackPanel x:Name="StepSummary" Visibility="Collapsed">
          <Border Style="{StaticResource Card}">
            <TextBlock x:Name="SummaryText" LineHeight="22"/>
          </Border>
          <TextBlock Style="{StaticResource Muted}" Text="After you press Lock, loosening any of this needs your delay or your partner's code. Making the delay longer is always instant."/>
          <Button x:Name="LockButton" Content="Lock" Style="{StaticResource Primary}" FontSize="18" Padding="40,12" HorizontalAlignment="Left" Margin="0,16,0,0" Click="Lock_Click"/>
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </DockPanel>
</UserControl>
