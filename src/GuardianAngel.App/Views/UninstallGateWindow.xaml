<Window x:Class="GuardianAngel.App.Views.UninstallGateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Uninstall Guardian Angel" Width="520" Height="300" WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource Background}" FontFamily="Segoe UI">
  <StackPanel Margin="24">
    <TextBlock Text="Uninstall Guardian Angel" Style="{StaticResource H2}" Margin="0,0,0,8"/>
    <TextBlock x:Name="MessageText" Text="Checking..."/>
    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
      <Button x:Name="OpenAppButton" Content="Open Guardian Angel" Style="{StaticResource Primary}" Click="OpenApp_Click" Visibility="Collapsed"/>
      <Button Content="Close" Click="Close_Click"/>
    </StackPanel>
  </StackPanel>
</Window>
