<UserControl x:Class="GuardianAngel.App.Views.DelayPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Orientation="Horizontal">
    <TextBox x:Name="AmountBox" Width="80" Text="24"/>
    <ComboBox x:Name="UnitBox" Width="120" Margin="8,4,0,8" SelectedIndex="1">
      <ComboBoxItem Content="minutes"/>
      <ComboBoxItem Content="hours"/>
      <ComboBoxItem Content="days"/>
    </ComboBox>
  </StackPanel>
</UserControl>
