<UserControl x:Class="GuardianAngel.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="32,24" MaxWidth="760" HorizontalAlignment="Left">
      <TextBlock x:Name="LockTitle" Style="{StaticResource H1}" Text="Locked"/>
      <TextBlock x:Name="LockSubtitle" Style="{StaticResource Muted}"/>
      <Border x:Name="SafeLockedCard" Style="{StaticResource Card}" Visibility="Collapsed" BorderBrush="{StaticResource Bad}" Margin="0,12,0,0">
        <TextBlock x:Name="SafeLockedText" Foreground="{StaticResource Bad}"/>
      </Border>

      <WrapPanel Margin="0,16,0,16">
        <Button Content="Request change" Style="{StaticResource Primary}" Click="RequestChange_Click" Margin="0,0,8,8"/>
        <Button Content="Request unlock window" IsEnabled="False" ToolTip="Coming in the next version" Margin="0,0,8,8"/>
        <Button Content="Vault" IsEnabled="False" ToolTip="Coming in the next version" Margin="0,0,8,8"/>
      </WrapPanel>

      <TextBlock Text="Pending changes" Style="{StaticResource H2}"/>
      <TextBlock x:Name="NoPending" Style="{StaticResource Muted}" Text="Nothing is waiting."/>
      <ItemsControl x:Name="PendingList">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Card}">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Content="Expedite (partner code)" Tag="{Binding Id}" Click="Expedite_Click" Visibility="{Binding ExpediteVisibility}"/>
                  <Button Content="Cancel" Tag="{Binding Id}" Click="Cancel_Click" Margin="0"/>
                </StackPanel>
                <StackPanel>
                  <TextBlock Text="{Binding Description}" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding Countdown}" Style="{StaticResource Muted}"/>
                </StackPanel>
              </DockPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Text="Protection checklist" Style="{StaticResource H2}"/>
      <ItemsControl x:Name="Checklist">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <DockPanel Margin="0,4">
              <TextBlock DockPanel.Dock="Left" Text="{Binding Icon}" Foreground="{Binding Color}" FontWeight="Bold" Width="24"/>
              <StackPanel>
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}"/>
              </StackPanel>
            </DockPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Text="Recently" Style="{StaticResource H2}"/>
      <ItemsControl x:Name="HistoryList">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <TextBlock Style="{StaticResource Muted}" Margin="0,2" Text="{Binding Text}"/>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
